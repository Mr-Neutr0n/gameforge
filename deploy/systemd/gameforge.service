[Unit]
Description=GameForge API
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=gameforge
Group=gameforge
WorkingDirectory=/opt/sideprojects/gameforge/current/backend
EnvironmentFile=/etc/gameforge/gameforge.env
Environment=HOME=/var/lib/gameforge
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/sideprojects/gameforge/current/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8102 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGINT
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gameforge
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
