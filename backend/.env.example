# PostgreSQL on the shared EC2 host. URL-encode the password if needed.
DATABASE_URL=postgresql://gameforge:replace-with-database-password@127.0.0.1:5432/gameforge

# Backend JWT signing
JWT_SECRET=replace-with-long-random-jwt-secret

# Azure OpenAI text generation
AZURE_OPENAI_ENDPOINT=https://replace-with-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-azure-openai-key
AZURE_MODEL_TEXT=gpt-5-6-luna

# Persistent UTC-day limits shared across generation and iteration endpoints
GLOBAL_GENERATIONS_PER_DAY=100
USER_GENERATIONS_PER_DAY=2

# Public frontend origin and runtime mode
FRONTEND_URL=https://games.harikp.com
ENVIRONMENT=production
